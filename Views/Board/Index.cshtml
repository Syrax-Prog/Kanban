@model kanban.Models.Board

@{
    ViewData["Title"] = Model.Name;
    var totalCards = Model.Columns.Sum(c => c.Cards.Count);
}

@* One anti-forgery token for the whole page; inline-edit.js reads it and sends it with each save *@
@Html.AntiForgeryToken()

<div class="d-flex align-items-start justify-content-between mb-4 gap-3">
    <div class="flex-grow-1" style="max-width: 36rem;">
        <textarea class="inline-edit fs-3 fw-semibold" rows="1" maxlength="100" data-inline-edit
                  data-url="@Url.Action("RenameBoard", "Board")" data-id="@Model.Id"
                  aria-label="Board name">@Model.Name</textarea>
    </div>
    <span class="text-muted small pt-2 text-nowrap">
        @Model.Columns.Count columns &middot; @totalCards @(totalCards == 1 ? "card" : "cards")
    </span>
</div>

<div class="board">
    @foreach (var column in Model.Columns)
    {
        <section class="kanban-column" aria-label="@column.Name">
            <div class="d-flex align-items-center justify-content-between kanban-column-title">
                <span>@column.Name</span>
                <span class="badge rounded-pill text-bg-secondary">@column.Cards.Count</span>
            </div>

            @foreach (var item in column.Cards)
            {
                <div class="kanban-card">
                    <textarea class="inline-edit" rows="1" maxlength="200" data-inline-edit
                              data-url="@Url.Action("RenameCard", "Board")" data-id="@item.Id"
                              aria-label="Card title">@item.Title</textarea>
                </div>
            }

            @if (!column.Cards.Any())
            {
                <p class="text-muted small fst-italic mb-2">No cards yet</p>
            }

            <form asp-action="AddCard" method="post" class="mt-2">
                <input type="hidden" name="columnId" value="@column.Id" />
                <div class="input-group input-group-sm">
                    <input type="text" name="title" class="form-control" placeholder="Add a card..." maxlength="200"
                           required aria-label="New card title for @column.Name" />
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/inline-edit.js" asp-append-version="true"></script>
}
